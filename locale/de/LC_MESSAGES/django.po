#: accounts/admin.py:41
msgid "Approve selected accounts"
msgstr "Ausgewählte Konten freigeben"

#: accounts/admin.py:46
#, python-format
msgid "%(count)d account approved."
msgid_plural "%(count)d accounts approved."
msgstr[0] "%(count)d Konto freigegeben."
msgstr[1] "%(count)d Konten freigegeben."

#: accounts/admin.py:51
msgid "Block selected accounts"
msgstr "Ausgewählte Konten sperren"

#: accounts/admin.py:56
#, python-format
msgid "%(count)d account blocked."
msgid_plural "%(count)d accounts blocked."
