#: accounts/admin.py:61
msgid "Reset password (temporary password)"
msgstr "Passwort zurücksetzen (vorläufiges Passwort)"

#: accounts/admin.py:73
#, python-format
msgid ""
"Temporary password for %(username)s: %(password)s. They must choose a new "
"password after logging in."
msgstr ""
"Vorläufiges Passwort für %(username)s: %(password)s. Nach der Anmeldung muss"
" ein neues Passwort gewählt werden."

#: accounts/apps.py:7
msgid "Accounts"
msgstr "Konten"

#: accounts/forms.py:11
msgid "Email (optional)"
msgstr "E-Mail (optional)"

#: accounts/forms.py:13
msgid "Only so the admin can reach you. We don't send emails."
msgstr "Nur damit die Verwaltung Sie erreichen kann. Wir verschicken keine E-Mails."

#: accounts/forms.py:33
msgid "Your account is waiting for approval by the admin. Please try again later."
msgstr ""
"Ihr Konto wartet auf die Freigabe durch die Verwaltung. Bitte versuchen Sie "
"es später noch einmal."

#: accounts/models.py:13
msgid "must change password"
msgstr "muss Passwort ändern"

#: accounts/models.py:15
msgid "Set after the admin assigns a temporary password."
msgstr "Wird gesetzt, wenn die Verwaltung ein vorläufiges Passwort vergibt."

#: accounts/models.py:19
msgid "profile"
msgstr "Profil"

#: accounts/models.py:20
msgid "profiles"
msgstr "Profile"

#: accounts/templates/accounts/login.html:3
#: accounts/templates/accounts/login.html:5
#: accounts/templates/accounts/login.html:10
#: accounts/templates/accounts/register_done.html:7
#: core/templates/core/home.html:7
msgid "Log in"
msgstr "Anmelden"

#: accounts/templates/accounts/login.html:12
msgid "Forgot your password? Ask the admin to set a temporary one."
msgstr "Passwort vergessen? Bitten Sie die Verwaltung um ein vorläufiges Passwort."

#: accounts/templates/accounts/login.html:13
msgid "No account yet?"
msgstr "Noch kein Konto?"

#: accounts/templates/accounts/login.html:13
#: accounts/templates/accounts/register.html:3
#: accounts/templates/accounts/register.html:5
#: accounts/templates/accounts/register.html:10 core/templates/core/home.html:8
msgid "Create account"
msgstr "Konto erstellen"

#: accounts/templates/accounts/password_change.html:3
#: accounts/templates/accounts/password_change.html:5
msgid "Change password"
msgstr "Passwort ändern"

#: accounts/templates/accounts/password_change.html:7
msgid ""
"You are using a temporary password. Please choose your own password to "
"continue."
msgstr ""
"Sie verwenden ein vorläufiges Passwort. Bitte wählen Sie ein eigenes "
"Passwort, um fortzufahren."

#: accounts/templates/accounts/password_change.html:12
msgid "Save password"
msgstr "Passwort speichern"

#: accounts/templates/accounts/password_change_done.html:3
#: accounts/templates/accounts/password_change_done.html:5
msgid "Password changed"
msgstr "Passwort geändert"

#: accounts/templates/accounts/password_change_done.html:6
msgid "Your new password is saved."
msgstr "Ihr neues Passwort ist gespeichert."

#: accounts/templates/accounts/password_change_done.html:7
msgid "Continue"
msgstr "Weiter"

#: accounts/templates/accounts/register.html:6
msgid "After you register, the admin approves your account. Then you can log in."
msgstr ""
"Nach der Registrierung gibt die Verwaltung Ihr Konto frei. Danach können Sie"
" sich anmelden."

#: accounts/templates/accounts/register_done.html:3
msgid "Account created"
msgstr "Konto erstellt"

#: accounts/templates/accounts/register_done.html:5
msgid "Thank you!"
msgstr "Vielen Dank!"

#: accounts/templates/accounts/register_done.html:6
msgid ""
"Your account has been created and is waiting for approval by the admin. You "
"can log in once it has been approved."
msgstr ""
"Ihr Konto wurde erstellt und wartet auf die Freigabe durch die Verwaltung. "
"Sobald es freigegeben ist, können Sie sich anmelden."

